# 复制为 .env 后填写。环境变量优先级高于本文件；所有密钥在使用时惰性读取，改完无需重启。

# ---- LLM 密钥（必须）：面板内容生成与问答代理全靠它 ----
# 获取：https://platform.deepseek.com 注册 → API Keys → 创建（需充值，日常约几元/周）
DEEPSEEK_API_KEY=
# GLM_API_KEY=     # 智谱（可选，checker 校验模型用）
# ARK_API_KEY=     # 豆包/火山方舟（可选）

# ---- 模型路由覆盖（可选，格式 provider:model）----
# HARNESS_ROUTE_FLASH=deepseek:deepseek-chat
# HARNESS_ROUTE_PRO=deepseek:deepseek-reasoner
# HARNESS_ROUTE_CHECKER=glm:glm-4-flash

# ---- 数据源（推荐）----
# Finnhub 免费档：美股机构评级 / 财报日历 / 估值指标。https://finnhub.io 注册即得（免费 30 次/分钟足够）
# 不配则美股机构数据缺失（页面如实标注，不影响其他功能）
FINNHUB_API_KEY=
# FUTU_HOST=127.0.0.1
# FUTU_PORT=11111

# ---- 联网搜索（可选）：问答/新闻联网。不配则用免费源（搜狗/360/百度）----
# BOCHA_API_KEY=   # 博查，中文质量高，约 ¥0.036/次，https://open.bochaai.com
# TAVILY_API_KEY=  # Tavily，英文质量高，免费 1000 次/月，https://tavily.com

# ---- 服务 ----
# HARNESS_PORT=7788
# QUOTE_POLL_INTERVAL=10
# 预警命中外发（企业微信群机器人 / Telegram），不配则只在面板内展示
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 可选：westock CLI（腾讯自选股研报库/机构评级，免费免登录二进制）路径，缺省 ~/.local/bin/westock
# 缺失时研报分层与全文功能如实降级为评级摘要
# WESTOCK_BIN=/usr/local/bin/westock
